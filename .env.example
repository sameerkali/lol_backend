MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
MONGODB_DB_NAME=loyalty

PORT=5001
NODE_ENV=development

# CORS allowlist. One origin, or several comma-separated (e.g. apex + www).
# Trailing slashes are stripped automatically, so either form is safe.
# Production: https://lol.expendifii.com
FRONTEND_URL=http://localhost:3000

# This backend's own public URL. Production: https://lol-api.expendifii.com
# Leave unset for local dev — it falls back to http://localhost:$PORT.
API_BASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used to reversibly encrypt the business PIN so owners/admins can view it in
# the panel (verification still uses a separate bcrypt hash). Falls back to
# JWT_SECRET if unset, but set a dedicated value in production.
PIN_ENCRYPTION_KEY=

ADMIN_NAME=Expendifii Admin
ADMIN_EMAIL=admin@expendifii.com
ADMIN_PASSWORD=ChangeMe123!
